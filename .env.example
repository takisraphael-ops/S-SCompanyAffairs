# Copy to .env.local (Next) / .env (scripts) and fill in.

# --- Database -------------------------------------------------------------
# Local dev, Neon, Supabase, whatever. Must be Postgres.
DATABASE_URL=postgres://postgres@localhost:5432/company_affairs

# --- Providers ------------------------------------------------------------
# Which adapter serves each capability.
#   QUOTE_PROVIDER=mock     -> deterministic fake data, no API key needed
#   QUOTE_PROVIDER=finnhub  -> real quotes, requires FINNHUB_API_KEY
QUOTE_PROVIDER=mock
FILINGS_PROVIDER=edgar

# News adapters to run, comma-separated: mock, finnhub, rss.
# Several run together on purpose — no single free source sees everything, and
# story clustering collapses the overlap.
NEWS_PROVIDERS=mock
# How far back each news ingest run looks.
NEWS_LOOKBACK_DAYS=7

# Free tier: https://finnhub.io/register  (~60 req/min)
FINNHUB_API_KEY=

# SEC requires a declarative User-Agent identifying you, or it returns 403.
# Format: "Your Name your@email.com"
SEC_USER_AGENT=Your Name your@email.com

# --- AI summaries and explanations ----------------------------------------
#   LLM_PROVIDER=mock       -> clearly-labelled placeholder text, no key needed
#   LLM_PROVIDER=anthropic  -> real generation, requires ANTHROPIC_API_KEY
# Everything generated is cached by the inputs it was generated from, so a
# summary is paid for once and regenerates only when its inputs change.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# Two models: the cheap one restates documents, the capable one explains
# figures in context. Override either if you want to spend more or less.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# Ceiling on generations per ingest run, so a first run over a full backlog
# cannot spend the budget in one go. Newest work is done first.
AI_MAX_GENERATIONS_PER_RUN=25

# --- Cron -----------------------------------------------------------------
# Shared secret for /api/cron/* routes. Required in production.
# Generate with: openssl rand -hex 32
CRON_SECRET=
